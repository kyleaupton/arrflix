# Two targets: `dev` is the day-to-day dev container (docker-compose.yml builds
# it), and `factory` extends it into the environment a factory run works in.
FROM ubuntu:24.04 AS dev

ARG GO_VERSION=1.25.5
ARG S6_VERSION=3.2.1.0
ARG NODE_VERSION=22
ARG ARRFLIX_VERSION="dev"
ARG ARRFLIX_COMMIT=""
ARG ARRFLIX_BUILD_DATE=""

RUN apt-get update && \
    apt-get install -y \
        xz-utils \
        curl \
        jq \
        gcc \
        postgresql \
        postgresql-client \
        nginx \
        ca-certificates \
        mediainfo \
    && rm -rf /var/lib/apt/lists/*

# Install Go
ARG TARGETARCH
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz -o /tmp/go.tgz && \
    tar -C /usr/local -xzf /tmp/go.tgz && \
    rm /tmp/go.tgz

# Install Air for Go live reload
RUN curl -fsSL https://raw.githubusercontent.com/cosmtrek/air/master/install.sh | bash -s -- -b /usr/local/bin

ENV PATH="/usr/local/go/bin:${PATH}"

# Install Go dev tools. golangci-lint matches the version used in CI.
RUN GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.2 && \
    GOBIN=/usr/local/bin go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.30.0

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - && \
  apt-get update && \
  apt-get install -y --no-install-recommends nodejs && \
  rm -rf /var/lib/apt/lists/*

# Playwright MCP server and its browsers, so agents can look at the UI they
# build (web/scripts/browser-mcp.mjs). Chromium backs the desktop entry and
# WebKit the iPhone one. Browsers live outside any HOME so the factory's
# non-root, throwaway-HOME agents find them too.
ARG PLAYWRIGHT_MCP_VERSION=0.0.85
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm install -g @playwright/mcp@${PLAYWRIGHT_MCP_VERSION} && \
    playwright-mcp install-browser --with-deps --no-shell chromium webkit && \
    chmod -R a+rX /ms-playwright && \
    rm -rf /var/lib/apt/lists/*

# Install s6-overlay
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_VERSION}/s6-overlay-noarch.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz
RUN S6_ARCH=$([ "${TARGETARCH}" = "arm64" ] && echo "aarch64" || echo "x86_64") && \
    curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_VERSION}/s6-overlay-${S6_ARCH}.tar.xz -o /tmp/s6-overlay-arch.tar.xz && \
    tar -C / -Jxpf /tmp/s6-overlay-arch.tar.xz && \
    rm /tmp/s6-overlay-arch.tar.xz

# Install Prowlarr
ARG PROWLARR_VERSION=2.3.0.5236
RUN PROWLARR_ARCH=$([ "${TARGETARCH}" = "arm64" ] && echo "linux-core-arm64" || echo "linux-core-x64") && \
    set -eux && \
    mkdir -p /opt/prowlarr && cd /opt/prowlarr && \
    curl -fsSL https://github.com/Prowlarr/Prowlarr/releases/download/v${PROWLARR_VERSION}/Prowlarr.master.${PROWLARR_VERSION}.${PROWLARR_ARCH}.tar.gz -o prowlarr.tar.gz && \
    tar -xzf prowlarr.tar.gz --strip-components=1 && \
    rm prowlarr.tar.gz && \
    ln -sf /opt/prowlarr/Prowlarr /usr/local/bin/prowlarr

# Copy the project code
WORKDIR /app

# s6 services
COPY docker/s6 /etc/s6-overlay

ENV PATH="/command:$PATH"

ENV APP_ENV=dev
ENV ARRFLIX_VERSION=${ARRFLIX_VERSION}
ENV ARRFLIX_COMMIT=${ARRFLIX_COMMIT}
ENV ARRFLIX_BUILD_DATE=${ARRFLIX_BUILD_DATE}
ENV PROWLARR_VERSION=${PROWLARR_VERSION}
ENTRYPOINT ["/init"]

# --- factory -----------------------------------------------------------------
# The environment an agent works in during a factory run (factory/WORKFLOW.md):
# the dev image plus the tools a run drives. A run's checkout is bind-mounted at
# /app and the dev services run it as usual. `just` runs commands directly
# (ARRFLIX_IN_CONTAINER) and the integration tests use this container's own
# Postgres (ARRFLIX_TEST_PG_DSN), so the container needs no docker socket.
FROM dev AS factory

ARG TARGETARCH
ARG JUST_VERSION=1.51.0
ARG CLAUDE_CODE_VERSION=latest

RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

RUN JUST_ARCH=$([ "${TARGETARCH}" = "arm64" ] && echo "aarch64" || echo "x86_64") && \
    curl -fsSL https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${JUST_ARCH}-unknown-linux-musl.tar.gz \
      | tar -xz -C /usr/local/bin just

RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

ENV ARRFLIX_IN_CONTAINER=1
ENV ARRFLIX_TEST_PG_DSN="postgres://postgres@127.0.0.1:5432/postgres?sslmode=disable"
