TMDB_API_KEY="foo-bar"
MEDIA_LIBRARIES="/foo/bar"

# Optional: host port for the prod-like container (just prod-up). Defaults to 8484.
# ARRFLIX_PROD_PORT="8485"

# Optional: overrides for running a second dev stack on the same host (e.g. in
# a git worktree). Defaults suit a single stack; see docker-compose.yml.
# COMPOSE_PROJECT_NAME="arrflix-feat-x"
# ARRFLIX_DEV_CONTAINER="arrflix-dev-feat-x"
# ARRFLIX_DEV_PORT="8494"
# ARRFLIX_DEV_IMAGE="arrflix:dev-feat-x"
