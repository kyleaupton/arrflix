<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.media.title}} is ready to watch</title>
</head>
<body style="margin:0; padding:0; background-color:#0f1115; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#0f1115; padding:24px 12px;">
<tr>
<td align="center">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px; background-color:#181b22; border-radius:12px; overflow:hidden;">
<tr>
<td style="padding:32px 32px 8px 32px;">
<p style="margin:0; font-size:13px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#8a90a2;">Ready to watch</p>
<h1 style="margin:8px 0 0 0; font-size:24px; line-height:1.25; font-weight:700; color:#ffffff;">{{.media.title}}{{if .media.year}} <span style="font-weight:400; color:#8a90a2;">({{.media.year}})</span>{{end}}</h1>
</td>
</tr>
<tr>
<td style="padding:16px 32px 8px 32px;">
<p style="margin:0; font-size:15px; line-height:1.6; color:#c7ccd8;">Good news — your request is now available in the library and ready to play.</p>
</td>
</tr>
{{if .plexLink}}
<tr>
<td style="padding:24px 32px 32px 32px;">
<a href="{{.plexLink}}" style="display:inline-block; background-color:#e5a00d; color:#1a1c20; font-size:15px; font-weight:600; text-decoration:none; padding:12px 24px; border-radius:8px;">Play now</a>
</td>
</tr>
{{else}}
<tr>
<td style="padding:8px 32px 32px 32px;">
<p style="margin:0; font-size:14px; line-height:1.6; color:#8a90a2;">Open your library to start watching.</p>
</td>
</tr>
{{end}}
</table>
<p style="margin:20px 0 0 0; font-size:12px; color:#5b6172;">Sent by Arrflix</p>
</td>
</tr>
</table>
</body>
</html>
