<!--
  invite.created — an admin invited someone; here's their magic link.
  Compiles to templates/invite/created/email.body.html.tmpl. Payload is
  {acceptUrl}; only the CTA href is templated (a structural/numeric MJML
  attribute is never). The link is unconditional — the service enqueues this
  email only once it has a URL to build. dk-* css-classes drive dark mode (see
  partials/head.mjml).
-->
<mjml lang="en">
  <mj-head>
    <mj-include path="partials/head.mjml" />
    <mj-title>You're invited to Arrflix</mj-title>
    <mj-preview>Set up your account to start requesting.</mj-preview>
  </mj-head>
  <mj-body css-class="dk-page" background-color="#fafafa" width="480px">
    <mj-include path="partials/header.mjml" />

    <mj-section css-class="dk-card" background-color="#ffffff" border="1px solid #e5e5e5" border-radius="14px" padding="32px">
      <mj-column>
        <mj-text css-class="dk-muted" color="#737373" font-size="12px" font-weight="600" letter-spacing="0.06em" text-transform="uppercase">
          You're invited
        </mj-text>
        <mj-text css-class="dk-fg" color="#0a0a0a" font-size="24px" font-weight="600" line-height="1.3" padding-top="6px">
          Join Arrflix
        </mj-text>
        <mj-text css-class="dk-body" padding-top="14px">
          An administrator has invited you to Arrflix. Set up your account to start requesting movies and
          shows.
        </mj-text>

        <mj-button css-class="dk-btn" href="{{.acceptUrl}}" align="left" padding="24px 0 0">Accept invite</mj-button>

        <mj-text css-class="dk-muted" color="#737373" font-size="13px" padding-top="24px">
          This link expires in 7 days. If you weren't expecting this invite, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
