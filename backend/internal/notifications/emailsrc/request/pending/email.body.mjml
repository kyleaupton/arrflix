<!--
  request.pending — a request is waiting for someone who may decide it.
  Compiles to templates/request/pending/email.body.html.tmpl. Payload is
  {requestId, media:{title,year}, requester}. dk-* css-classes drive dark mode
  (see partials/head.mjml).
-->
<mjml lang="en">
  <mj-head>
    <mj-include path="partials/head.mjml" />
    <mj-title>New request: {{.media.title}}</mj-title>
    <mj-preview>{{.requester}} requested a title that needs review.</mj-preview>
  </mj-head>
  <mj-body css-class="dk-page" background-color="#fafafa" width="480px">
    <mj-include path="partials/header.mjml" />

    <mj-section css-class="dk-card" background-color="#ffffff" border="1px solid #e5e5e5" border-radius="14px" padding="32px">
      <mj-column>
        <mj-text css-class="dk-muted" color="#737373" font-size="12px" font-weight="600" letter-spacing="0.06em" text-transform="uppercase">
          New request
        </mj-text>
        <mj-text css-class="dk-fg" color="#0a0a0a" font-size="24px" font-weight="600" line-height="1.3" padding-top="6px">
          {{.media.title}}{{if .media.year}} <span style="font-weight:400;color:#737373;">({{.media.year}})</span>{{end}}
        </mj-text>
        <mj-text css-class="dk-body" padding-top="14px">
          From {{.requester}}. It's waiting in the review queue.
        </mj-text>
        <mj-text css-class="dk-muted" color="#737373" font-size="13px" padding-top="12px">
          Open Requests in Arrflix to approve or decline it.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
