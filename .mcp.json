{
  "mcpServers": {
    "arrflix": {
      "command": "npx",
      "args": ["-y", "tsx", "./mcp/src/index.ts"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn-vue@latest", "mcp"]
    },
    "browser-desktop": {
      "command": "docker",
      "args": ["compose", "exec", "-T", "arrflix-dev", "node", "/app/web/scripts/browser-mcp.mjs", "desktop"]
    },
    "browser-mobile": {
      "command": "docker",
      "args": ["compose", "exec", "-T", "arrflix-dev", "node", "/app/web/scripts/browser-mcp.mjs", "mobile"]
    }
  }
}
